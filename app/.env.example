# Backend base URL used by the mobile app.
#
# iOS simulator / web: http://localhost:8080
# Android emulator:   http://10.0.2.2:8080
# Physical device:    http://<your-computer-LAN-IP>:8080
#
# Copy this file to .env for shared defaults and put secrets in .env.local.
# Restart Expo after changing any value.
EXPO_PUBLIC_API_URL=http://localhost:8080

# Gnani Speech-to-Text. EXPO_PUBLIC values are embedded in the app bundle.
# Keep the real key in .env.local, which is ignored by git.
EXPO_PUBLIC_GNANI_API_KEY=
# Optional. en-IN handles English/Hinglish and returns Latin-script output.
EXPO_PUBLIC_GNANI_STT_LANGUAGE=en-IN
