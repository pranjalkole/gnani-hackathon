{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gnani.local/schemas/delivery-record.schema.json",
  "title": "DeliveryRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "poNumber",
    "deliveryNoteNumber",
    "supplier",
    "deliveryDate",
    "site",
    "worker",
    "items"
  ],
  "properties": {
    "clientRequestId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "poNumber": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,63}$"
    },
    "deliveryNoteNumber": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,63}$"
    },
    "supplier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "deliveryDate": {
      "type": "string",
      "format": "date"
    },
    "site": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "identifier"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "identifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "voiceTranscript": {
      "type": "string",
      "maxLength": 20000
    },
    "rawOcrText": {
      "type": "string",
      "maxLength": 20000
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "poItemId",
          "description",
          "quantity",
          "receivedQuantity",
          "damagedQuantity"
        ],
        "properties": {
          "poItemId": {
            "type": "string",
            "format": "uuid"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "quantity": {
            "type": "number",
            "exclusiveMinimum": 0,
            "multipleOf": 0.001
          },
          "receivedQuantity": {
            "type": "number",
            "minimum": 0,
            "multipleOf": 0.001
          },
          "damagedQuantity": {
            "type": "number",
            "minimum": 0,
            "multipleOf": 0.001
          },
          "remarks": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    }
  }
}
