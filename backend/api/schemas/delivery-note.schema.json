{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gnani.local/schemas/delivery-note.schema.json",
  "title": "ScannedDeliveryNote",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "poNumber",
    "deliveryNoteNumber",
    "supplier",
    "deliveryDate",
    "site",
    "items"
  ],
  "properties": {
    "poNumber": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,63}$"
    },
    "deliveryNoteNumber": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,63}$"
    },
    "supplier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "deliveryDate": {
      "type": "string",
      "format": "date"
    },
    "site": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "quantity"
        ],
        "properties": {
          "poItemId": {
            "type": "string",
            "format": "uuid"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "quantity": {
            "type": "number",
            "exclusiveMinimum": 0,
            "multipleOf": 0.001
          },
          "receivedQuantity": {
            "type": "number",
            "minimum": 0,
            "multipleOf": 0.001
          }
        }
      }
    },
    "rawOcrText": {
      "type": "string",
      "maxLength": 20000
    }
  }
}
